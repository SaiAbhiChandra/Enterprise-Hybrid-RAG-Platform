# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-real-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# These are used for local (non-Docker) development. When running
# via `docker compose up`, docker-compose.yml overrides these to
# point at the containerized services instead.
DATABASE_URL=postgresql://ehrp_user:ehrp_password@localhost:5433/ehrp_db
REDIS_URL=redis://localhost:6379
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Ollama running on your host machine. Named OLLAMA_BASE_URL, not
# OLLAMA_HOST, to avoid colliding with Ollama's own OLLAMA_HOST
# environment variable if you've set that system-wide.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
